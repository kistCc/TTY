{
  "name": "screen-translator",
  "version": "1.3.5",
  "description": "Screenshot, OCR, translate, and overlay — seamless screen translation tool",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:native && tsc",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build:native": "clang -O2 -fobjc-arc scripts/ocr-macos.m -o scripts/ocr-macos -framework Foundation -framework Vision -framework AppKit && clang -O2 -fobjc-arc scripts/hotkey-macos.m -o scripts/hotkey-macos -framework Foundation -framework Carbon -framework AppKit && clang -O2 -fobjc-arc scripts/axtext-macos.m -o scripts/axtext-macos -framework Foundation -framework AppKit -framework ApplicationServices"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "google-translate-api-x": "^10.7.2",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^9.0.0",
    "undici": "^8.0.2"
  },
  "build": {
    "appId": "com.screen-translator.app",
    "productName": "TTY",
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "TTY 需要屏幕录制权限才能截屏并翻译屏幕上的文字。"
      }
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "src/renderer/**/*",
      "!**/*.map",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!node_modules/**/*.{md,ts,map}",
      "!node_modules/**/{.github,LICENSE,CHANGELOG}*"
    ],
    "extraResources": [
      {
        "from": "scripts/ocr-macos",
        "to": "scripts/ocr-macos"
      },
      {
        "from": "scripts/ocr-macos.m",
        "to": "scripts/ocr-macos.m"
      },
      {
        "from": "scripts/hotkey-macos",
        "to": "scripts/hotkey-macos"
      },
      {
        "from": "scripts/hotkey-macos.m",
        "to": "scripts/hotkey-macos.m"
      },
      {
        "from": "scripts/axtext-macos",
        "to": "scripts/axtext-macos"
      },
      {
        "from": "scripts/axtext-macos.m",
        "to": "scripts/axtext-macos.m"
      }
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "dmg": {
      "title": "TTY ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
